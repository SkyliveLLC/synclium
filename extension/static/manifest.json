{
  "manifest_version": 3,
  "name": "Synclium",
  "version": "0.1.0",
  "description": "Sync bookmarks and history between your Helium browsers through a folder you already sync.",
  "minimum_chrome_version": "134",
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Synclium" },
  "options_ui": { "page": "app.html", "open_in_tab": true },
  "omnibox": { "keyword": "hs" },
  "permissions": ["bookmarks", "history", "storage", "unlimitedStorage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
